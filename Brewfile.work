# ─── Taps ─────────────────────────────────────────────
tap "atlassian/acli", trusted: true
tap "oven-sh/bun", trusted: true
tap "stablyai/orca", trusted: true

# ─── CLI Tools & Shells ───────────────────────────────
brew "git"                 # Distributed revision control system
brew "gh"                  # GitHub command-line tool
brew "awscli"              # Official Amazon AWS command-line interface
brew "aws-cdk"             # AWS Cloud Development Kit - define infra as code
brew "atlassian/acli/acli" # Atlassian Cloud CLI (Jira, Confluence)
brew "cocoapods"           # Dependency manager for Cocoa projects
brew "oven-sh/bun/bun"     # Bun - fast JS runtime, bundler, transpiler, package manager
brew "python"              # Latest Python (alias tracks newest python@3.x)
brew "herdr"               # Agent multiplexer that lives in your terminal
brew "playwright-cli"      # Playwright CLI: codegen, selector inspection, screenshots
brew "sonar-scanner"       # Launcher to analyze a project with SonarQube

# ─── Development & Infrastructure ─────────────────────
brew "colima"              # Container runtimes on macOS with minimal setup
brew "docker"              # Pack, ship and run applications as containers
brew "docker-compose"      # Isolated development environments using Docker
brew "ollama"              # Run large language models locally

# ─── Media & Utilities ────────────────────────────────
brew "ffmpeg"              # Play, record, convert, and stream audio and video

# ─── Desktop Applications - Development Tools ─────────
cask "visual-studio-code"  # Open-source code editor
cask "cursor"              # AI-powered code editor
cask "cursor-cli"          # Command-line agent for Cursor
cask "jetbrains-toolbox"   # JetBrains tools manager
cask "ghostty"             # GPU-accelerated native terminal emulator
cask "stablyai/orca/orca"  # IDE for orchestrating AI coding agents across worktrees
cask "bruno"               # Open source IDE for exploring and testing APIs
cask "sourcetree"          # Graphical Git client
cask "drawio"              # draw.io diagramming desktop app

# ─── Desktop Applications - AI Tools ──────────────────
cask "claude"              # Anthropic's official Claude desktop app
cask "claude-code"         # Terminal-based AI coding assistant
cask "codex"               # OpenAI's coding agent for the terminal
cask "codexbar"            # Menu bar tracker for agentic coding limits and usage
cask "chatgpt"             # OpenAI's official ChatGPT desktop app

# ─── Desktop Applications - Creative & Design ─────────
cask "figma"               # Collaborative interface design tool

# ─── Desktop Applications - Productivity & Utilities ──
cask "rectangle"           # Window snapping and resizing tool
cask "1password"           # Secure password manager
cask "1password-cli"       # Command-line interface for 1Password
cask "openlogi"            # Local-first alternative to Logitech Options+
cask "mos"                 # Smooth scrolling and scroll direction control
cask "stats"               # System monitor for the menu bar
cask "obsidian"            # Markdown knowledge base on local files

# ─── Desktop Applications - Browsers ──────────────────
cask "google-chrome"       # Web browser

# ─── Desktop Applications - Communication ─────────────
cask "slack"               # Team communication and collaboration software

# ─── VSCode Extensions ────────────────────────────────
vscode "mechatroner.rainbow-csv" # Highlight and colorize CSV files
